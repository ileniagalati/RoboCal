<Simulation>
  <Material name="wall">
    <Friction material="ballPlastic" value="0.2"/>
  </Material>

  <Compound name="field">
    <!-- Pavimento / Moquette del campo -->
    <BoxGeometry depth="4.0m" width="5.0m" height="0.2m" color="rgb(80, 80, 80)">
      <Translation x="1.7m" y="0m" z="-0.1m"/>
      <Material name="fieldCarpet"/>
    </BoxGeometry>

    <!-- Parete posteriore (dietro la porta a x = 3.60m) -->
    <BoxGeometry depth="0.4m" width="5.4m" height="0.8m" color="rgb(70, 70, 70)">
      <Translation x="3.80m" y="0m" z="0.4m"/>
      <Material name="wall"/>
    </BoxGeometry>

    <!-- Parete anteriore (oltre metà campo a x = -0.20m) -->
    <BoxGeometry depth="0.4m" width="5.4m" height="0.8m" color="rgb(70, 70, 70)">
      <Translation x="-0.40m" y="0m" z="0.4m"/>
      <Material name="wall"/>
    </BoxGeometry>

    <!-- Parete laterale sinistra (a y = +2.40m) -->
    <BoxGeometry depth="4.4m" width="0.4m" height="0.8m" color="rgb(70, 70, 70)">
      <Translation x="1.7m" y="2.60m" z="0.4m"/>
      <Material name="wall"/>
    </BoxGeometry>

    <!-- Parete laterale destra (a y = -2.40m) -->
    <BoxGeometry depth="4.4m" width="0.4m" height="0.8m" color="rgb(70, 70, 70)">
      <Translation x="1.7m" y="-2.60m" z="0.4m"/>
      <Material name="wall"/>
    </BoxGeometry>

    <Compound ref="fieldGoal" name="Goal2">
      <Translation x="3.25m" y="0m"/>
      <Rotation z="180degree"/>
      <Set name="color" value="goalWhite"/>
    </Compound>
    <ComplexAppearance ref="fieldLines"/>
    <ComplexAppearance ref="fieldCenterCircle"/>
    <ComplexAppearance ref="fieldCrosses"/>
    <ComplexAppearance ref="fieldGreen"/>
  </Compound>

  <Compound name="fieldGoal">
    <CylinderGeometry height="800mm" radius="50mm" name="post1">
      <Translation y="-800mm" z="400mm"/>
    </CylinderGeometry>
    <CylinderGeometry height="800mm" radius="50mm" name="post2">
      <Translation y="800mm" z="400mm"/>
    </CylinderGeometry>
    <CylinderAppearance height="850mm" radius="50mm" name="post1">
      <Translation y="-800mm" z="425mm"/>
      <Surface ref="goalWhite"/>
    </CylinderAppearance>
    <CylinderAppearance height="850mm" radius="50mm" name="post2">
      <Translation y="800mm" z="425mm"/>
      <Surface ref="goalWhite"/>
    </CylinderAppearance>
    <CapsuleAppearance height="1700mm" radius="50mm" name="crossbar">
      <Rotation x="90degree"/>
      <Translation z="850mm"/>
      <Surface ref="goalWhite"/>
    </CapsuleAppearance>
    <!-- Side supports extending back by 350mm (0.35m) to the wall -->
    <BoxAppearance depth="350mm" width="20mm" height="20mm" name="netSupport1">
      <Surface ref="goalWhite"/>
      <Translation x="-175mm" y="800mm" z="790mm"/>
    </BoxAppearance>
    <BoxAppearance depth="350mm" width="20mm" height="20mm" name="netSupport1b">
      <Surface ref="goalWhite"/>
      <Translation x="-175mm" y="800mm" z="10mm"/>
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="20mm" height="760mm" name="netSupport1c">
      <Surface ref="goalWhite"/>
      <Translation x="-350mm" y="800mm" z="400mm"/>
    </BoxAppearance>
    <BoxAppearance depth="350mm" width="20mm" height="20mm" name="netSupport2">
      <Surface ref="goalWhite"/>
      <Translation x="-175mm" y="-800mm" z="790mm"/>
    </BoxAppearance>
    <BoxAppearance depth="350mm" width="20mm" height="20mm" name="netSupport2b">
      <Surface ref="goalWhite"/>
      <Translation x="-175mm" y="-800mm" z="10mm"/>
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="20mm" height="760mm" name="netSupport2c">
      <Surface ref="goalWhite"/>
      <Translation x="-350mm" y="-800mm" z="400mm"/>
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="1580mm" height="20mm" name="netSupportQ">
      <Surface ref="goalWhite"/>
      <Translation x="-350mm" y="0mm" z="790mm"/>
    </BoxAppearance>
    <BoxAppearance depth="20mm" width="1580mm" height="20mm" name="netSupportQb">
      <Surface ref="goalWhite"/>
      <Translation x="-350mm" y="0mm" z="10mm"/>
    </BoxAppearance>
    <ComplexAppearance ref="fieldNet"/>
    <!-- Back collision board (parete del laboratorio dietro la porta) -->
    <BoxGeometry width="1600mm" height="0.8m" depth="0.3m">
      <Translation x="-475mm" z="0.4m"/>
      <Material name="wall"/>
    </BoxGeometry>
    <BoxGeometry width="0.1m" height="0.8m" depth="350mm">
      <Translation x="-175mm" y="-850mm" z="0.4m"/>
      <Material name="wall"/>
    </BoxGeometry>
    <BoxGeometry width="0.1m" height="0.8m" depth="350mm">
      <Translation x="-175mm" y="850mm" z="0.4m"/>
      <Material name="wall"/>
    </BoxGeometry>
  </Compound>
  <Surface name="fieldGreen" diffuseColor="#000000" ambientColor="#279f27" diffuseTexture="../Textures/shadow_grad.png"/>
  <Surface name="fieldNet" diffuseColor="rgb(100%, 100%, 100%)" diffuseTexture="../Textures/net.png"/>
  <Surface name="fieldWhite" diffuseColor="rgb(100%, 100%, 100%)" specularColor="rgb(80%, 80%, 80%)" shininess="10" diffuseTexture="../Textures/shadow_frizzle.png"/>
  <Surface name="goalWhite" diffuseColor="rgb(70%, 70%, 70%)" ambientColor="rgb(45%, 45%, 45%)" specularColor="rgb(40%, 40%, 40%)" shininess="30"/>
  <Vertices name="fieldGreen">
    -0.2 -2.4 -0.001
     3.65 -2.4 -0.001
     3.65  2.4 -0.001
    -0.2  2.4 -0.001
